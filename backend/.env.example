# Copy to backend/.env and fill in real values. Never commit the real .env.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<publishable/anon key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role secret — backend only, bypasses RLS>"

# Use independent, random 256-bit values (e.g. `openssl rand -hex 32`).
JWT_SECRET="<random secret>"
JWT_REFRESH_SECRET="<a DIFFERENT random secret>"

CLINIC_ID="clinic-001"
PORT=4000
FRONTEND_URL="http://localhost:3000"
